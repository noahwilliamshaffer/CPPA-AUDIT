# ─────────────────────────────────────────────────────────────────────────────
# ShieldAudit — Docker environment
# cp .env.docker.example .env.docker  then fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string (same one you use for local dev)
# Get from: https://console.neon.tech → your project → Connection string
DATABASE_URL=postgresql://neondb_owner:your_password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# Clerk authentication
# Get from: https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_secret_here

# Clerk redirect URLs
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Feature flags
STORAGE_MODE=mock
STRIPE_MODE=mock

# Stripe (only needed when STRIPE_MODE=live)
# Get from: https://dashboard.stripe.com → Developers → API Keys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_ID_ASSESSMENT=price_your_price_id_here

# App URL (used for Stripe checkout redirect URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
