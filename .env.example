# =============================================================================
# ShieldAudit — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# =============================================================================

# Clerk Auth — https://clerk.com/docs/quickstarts/nextjs
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# PostgreSQL — Neon (https://neon.tech) or Railway
# §7123 requires 5-year data retention; ensure your DB plan supports this
DATABASE_URL=postgresql://user:password@host:5432/shieldaudit

# Stripe — Per-assessment billing ($300–$500 per completed assessment)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_ID_ASSESSMENT=price_...

# AWS S3 / Cloudflare R2 — Evidence Locker file storage
# §7123 mandates 5-year minimum retention for audit records
S3_BUCKET_NAME=shieldaudit-evidence
S3_REGION=us-west-2
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ShieldAudit

# Feature flags — set to "mock" in dev, "live" in prod
# STORAGE_MODE=mock skips S3 uploads and returns a local file URL
# STRIPE_MODE=mock skips Stripe checkout and auto-unlocks assessments
# STORAGE_MODE=mock also short-circuits the ADD-17 AI autofill pipeline (no API calls)
STORAGE_MODE=mock
STRIPE_MODE=mock

# Anthropic AI — ADD-17 document ingestion & assessment autofill
# Required only for real AI analysis (i.e. when STORAGE_MODE != mock).
# Get a key from https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (defaults to claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Integrations (all optional) — see /dashboard/integrations
# Jira — create remediation issues from audit findings (Jira Cloud, API token)
# JIRA_BASE_URL=https://your-site.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=...                 # https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_PROJECT_KEY=SEC
# Notifications — incoming webhook URLs (no OAuth)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/...
# WEBHOOK_URL=https://your-endpoint.example.com/hook
#
# Publish targets — push the audit summary / SSP (Atlassian API token = Basic auth)
# CONFLUENCE_BASE_URL=https://your-site.atlassian.net
# CONFLUENCE_EMAIL=you@example.com
# CONFLUENCE_API_TOKEN=...
# CONFLUENCE_SPACE_KEY=SEC
# CONFLUENCE_PARENT_PAGE_ID=            # optional
# NOTION_TOKEN=secret_...               # Notion internal integration token
# NOTION_PARENT_PAGE_ID=...             # page the integration can write to
#
# Evidence locker — S3 / S3-compatible (R2, MinIO, Wasabi). Canonical keys:
# S3_BUCKET=shieldaudit-evidence
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_ENDPOINT=                          # set for S3-compatible (path-style); omit for AWS
# S3_PREFIX=                            # optional key prefix
#
# Scaffolded connectors (SSO-evidence / evidence-pull / GRC / e-sign) — enter
# these in the in-app Credentials UI, or via env. Examples:
# OKTA_DOMAIN=example.okta.com
# OKTA_API_TOKEN=...
# ENTRA_TENANT_ID=  ENTRA_CLIENT_ID=  ENTRA_CLIENT_SECRET=
# AWS_ACCESS_KEY_ID=  AWS_SECRET_ACCESS_KEY=  AWS_REGION=us-east-1
# TENABLE_ACCESS_KEY=  TENABLE_SECRET_KEY=
# CROWDSTRIKE_CLIENT_ID=  CROWDSTRIKE_CLIENT_SECRET=  CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com
# INTUNE_TENANT_ID=  INTUNE_CLIENT_ID=  INTUNE_CLIENT_SECRET=
# VANTA_API_TOKEN=   DRATA_API_KEY=   SECUREFRAME_API_KEY=
# ONETRUST_BASE_URL=  ONETRUST_API_TOKEN=
# DOCUSIGN_BASE_URI=https://demo.docusign.net  DOCUSIGN_ACCOUNT_ID=  DOCUSIGN_ACCESS_TOKEN=
# ADOBESIGN_BASE_URI=https://api.na1.adobesign.com  ADOBESIGN_ACCESS_TOKEN=
