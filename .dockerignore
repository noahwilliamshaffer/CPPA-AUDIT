# Dependencies (rebuilt inside container)
node_modules
npm-debug.log*

# Next.js build output
.next
out

# Environment files — never bake secrets into the image
.env
.env.local
.env.docker
.env*.local

# Git
.git
.gitignore

# Dev tooling
.eslintrc*
eslint.config*
*.test.*
__tests__
coverage

# OS / editor
.DS_Store
Thumbs.db
.vscode
.idea

# Logs
*.log
dev-server*.log

# Local SQLite database (runtime data lives in the /data volume, not the image)
*.db
*.db-shm
*.db-wal

# Local secrets-encryption key (must never be baked into the image)
.shieldaudit.key

# Evidence Locker uploads (runtime data; lives on the /data volume)
/evidence/

# Agent / tooling scratch + demo assets (not needed in the runtime image)
.claude
demo
*.tgz
