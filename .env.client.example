# =============================================================================
# ShieldAudit — Client Environment
# =============================================================================
# Copy this file to .env.client and fill in your Clerk keys.
# That is the ONLY thing you need to configure.
#
# Everything else (database, Stripe, storage) is pre-configured in
# docker-compose.yml and managed automatically.
#
# Usage:
#   cp .env.client.example .env.client
#   # Edit .env.client and fill in your Clerk keys below
#   docker compose up --build
# =============================================================================

# ── Clerk Authentication ────────────────────────────────────────────────────
# Create a free Clerk app at https://clerk.com
# Dashboard → Your App → API Keys

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# ── Clerk redirect URLs (do not change) ────────────────────────────────────
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# =============================================================================
# The following values are set automatically by docker-compose.yml.
# You do NOT need to set them here.
#
# DATABASE_URL    → local PostgreSQL container (data stays on your machine)
# STORAGE_MODE    → mock (documents download directly, no S3 needed)
# STRIPE_MODE     → mock (payment is simulated, no Stripe account needed)
# NEXT_PUBLIC_APP_URL → http://localhost:3000
# =============================================================================
